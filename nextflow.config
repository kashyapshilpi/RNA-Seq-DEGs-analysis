manifest {
    name            = 'kashyapshilpi/RNA-Seq-DEGs-analysis'
    author          = 'Shilpi Kumari'
    homePage        = 'https://github.com/kashyapshilpi/RNA-Seq-DEGs-analysis'
    description     = 'Paired-end RNA-seq differential expression: HISAT2, HTSeq, DESeq2 and edgeR'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

params {
    // Inputs
    input              = null      // CSV: sample,fastq_1,fastq_2,condition
    fasta              = null      // reference genome FASTA
    gtf                = null      // gene annotation GTF
    outdir             = 'results'

    // Trimming
    adapters           = "${projectDir}/assets/adapters/TruSeq3-PE.fa"
    min_len            = 36

    // Counting
    strandedness       = 'no'      // HTSeq -s: no | yes | reverse
    gtf_attribute      = 'gene_id'

    // Differential expression
    contrast_reference = 'control'
    contrast_target    = 'treatment'
    padj               = 0.05
    lfc                = 1
}

process {
    cpus   = 2
    memory = 4.GB
    time   = 4.h

    withLabel: process_low    { cpus = 2; memory = 4.GB  }
    withLabel: process_medium { cpus = 4; memory = 8.GB  }
    withLabel: process_high   { cpus = 8; memory = 16.GB }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy'
    ]

    // These write their own deseq2/ and edger/ folders
    withName: 'DESEQ2|EDGER' {
        publishDir = [path: { params.outdir }, mode: 'copy']
    }
}

profiles {
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    docker {
        // Containers are built on the fly from each process's conda packages by Wave
        docker.enabled = true
        wave.enabled   = true
        wave.strategy  = ['conda']
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
